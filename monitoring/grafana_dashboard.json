{
  "uid": "ipie-main",
  "title": "IPIE — IPL Predictive Intelligence Engine",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Win Probability (S1) — Live",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red",    "value": 0   },
              { "color": "yellow", "value": 0.4 },
              { "color": "green",  "value": 0.6 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "expr": "ipie_win_probability",
          "legendFormat": "Team A win prob"
        }
      ]
    },
    {
      "id": 2,
      "title": "Prediction Confidence Tag (S2)",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 4, "h": 4 },
      "targets": [
        { "expr": "ipie_confidence_tag", "legendFormat": "confidence" }
      ]
    },
    {
      "id": 3,
      "title": "Momentum Delta per Over (S7)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "steps": [
              { "color": "green", "value": -0.15 },
              { "color": "red",   "value":  0.15 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "ipie_momentum_delta", "legendFormat": "Δ win prob per over" }
      ],
      "options": {
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 4,
      "title": "Rolling 10-Match Accuracy",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "red",    "value": 0    },
              { "color": "yellow", "value": 0.65 },
              { "color": "green",  "value": 0.72 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "ipie_rolling_accuracy_10match", "legendFormat": "accuracy (10-match)" }
      ],
      "options": {
        "legend": { "displayMode": "list" }
      }
    },
    {
      "id": 5,
      "title": "End-to-End Latency (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "steps": [
              { "color": "green",  "value": 0     },
              { "color": "yellow", "value": 20000 },
              { "color": "red",    "value": 30000 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "ipie_e2e_latency_ms",          "legendFormat": "e2e latency"        },
        { "expr": "ipie_l1_inference_latency_ms",  "legendFormat": "L1 base models"     },
        { "expr": "ipie_l2_meta_latency_ms",       "legendFormat": "L2 meta-learner"    },
        { "expr": "ipie_l3_llm_latency_ms",        "legendFormat": "L3 LLM"             }
      ]
    },
    {
      "id": 6,
      "title": "LLM Cost per Match (USD)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 10, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "steps": [
              { "color": "green",  "value": 0    },
              { "color": "yellow", "value": 0.50 },
              { "color": "red",    "value": 1.00 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "ipie_llm_cost_usd_per_match", "legendFormat": "cost/match" }
      ]
    },
    {
      "id": 7,
      "title": "LLM Fallback Rate",
      "type": "stat",
      "gridPos": { "x": 18, "y": 10, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "green",  "value": 0    },
              { "color": "yellow", "value": 0.05 },
              { "color": "red",    "value": 0.15 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "rate(ipie_llm_fallback_total[5m]) / rate(ipie_llm_calls_total[5m])", "legendFormat": "fallback rate" }
      ]
    },
    {
      "id": 8,
      "title": "Feature Drift Status",
      "type": "table",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 6 },
      "targets": [
        { "expr": "ipie_feature_drift_detected", "legendFormat": "{{feature_group}}" }
      ],
      "options": {
        "footer": { "show": false }
      }
    },
    {
      "id": 9,
      "title": "Player Impact Scores (S5) — Top 11",
      "type": "bargauge",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 6 },
      "fieldConfig": {
        "defaults": { "min": 0, "max": 100, "unit": "none" }
      },
      "targets": [
        { "expr": "topk(11, ipie_player_impact_score)", "legendFormat": "{{player}}" }
      ]
    },
    {
      "id": 10,
      "title": "Season Winner Probability (S8)",
      "type": "barchart",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 6 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 }
      },
      "targets": [
        { "expr": "ipie_season_winner_probability", "legendFormat": "{{team}}" }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Momentum Alerts (S7)",
        "datasource": "prometheus",
        "expr": "ipie_momentum_alert == 1",
        "step": "60s",
        "titleFormat": "Momentum Alert",
        "textFormat": "Δ={{delta}} over={{over}}",
        "iconColor": "orange"
      },
      {
        "name": "Accuracy Drops",
        "datasource": "prometheus",
        "expr": "ipie_rolling_accuracy_10match < 0.65",
        "step": "300s",
        "titleFormat": "Accuracy below 65%",
        "iconColor": "red"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "match_id",
        "type": "query",
        "query": "label_values(ipie_win_probability, match_id)",
        "label": "Match",
        "refresh": 2
      }
    ]
  }
}
